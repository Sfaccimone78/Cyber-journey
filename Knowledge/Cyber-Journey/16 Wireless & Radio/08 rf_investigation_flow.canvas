{
  "nodes": [
    {
      "id": "node-1",
      "type": "text",
      "text": "# RF Investigation Start\nIdentify the target transmission or frequency of interest (e.g., 1090 MHz for ADS-B, 162 MHz for AIS).",
      "x": -400,
      "y": 0,
      "width": 250,
      "height": 120
    },
    {
      "id": "node-2",
      "type": "text",
      "text": "# Hardware Selection\nSelect appropriate SDR receiver (e.g., RTL-SDR, HackRF) and antenna tuned to the target wavelength.",
      "x": -100,
      "y": 0,
      "width": 250,
      "height": 120
    },
    {
      "id": "node-3",
      "type": "text",
      "text": "# Signal Discovery\nUse software (GQRX, SDR#) to visualize the spectrum. Monitor the FFT and Waterfall displays for active peaks.",
      "x": 200,
      "y": 0,
      "width": 250,
      "height": 120
    },
    {
      "id": "node-4",
      "type": "text",
      "text": "# Modulation Identification\nAnalyze the signal shape. Determine if it is Analog (AM, FM) or Digital (ASK, FSK, PSK).",
      "x": 500,
      "y": -100,
      "width": 250,
      "height": 120
    },
    {
      "id": "node-5",
      "type": "text",
      "text": "# Demodulation & Decoding\nPipe raw audio/IQ data to decoder tools (e.g., dump1090, multimon-ng, rtl_433).",
      "x": 500,
      "y": 100,
      "width": 250,
      "height": 120
    },
    {
      "id": "node-6",
      "type": "text",
      "text": "# Intelligence Extraction\nExtract and log final telemetry data: vessel names, flight routes, sensor values, or message payloads.",
      "x": 800,
      "y": 0,
      "width": 250,
      "height": 120
    }
  ],
